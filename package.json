{
  "name": "dsh-station-root",
  "version": "0.0.2-20260927",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "plugins:build": "pnpm --filter \"./packages/plugin-ui\" --filter \"./packages/plugins/**\" --if-present build",
    "plugins:prepare": "node scripts/plugin-distributions.mjs .dev/plugins",
    "dev:runtime": "node scripts/dev-runtime.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev": "node --import tsx scripts/dev-stack.mjs",
    "start": "node --import tsx scripts/dev-stack.mjs --built",
    "relay:init": "node scripts/relay-cli.mjs init",
    "relay:passwd": "node scripts/relay-cli.mjs passwd",
    "relay:totp-reset": "node scripts/relay-cli.mjs totp reset",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/release.mjs",
    "release:win:lite": "node scripts/release.mjs --target=win32-x64 --variant=lite",
    "release:win:full": "node scripts/release.mjs --target=win32-x64 --variant=full",
    "release:linux:lite": "node scripts/release.mjs --target=linux-x64 --variant=lite",
    "release:linux:full": "node scripts/release.mjs --target=linux-x64 --variant=full",
    "release:linux-server:lite": "node scripts/release.mjs --target=server --variant=lite",
    "release:linux-server:full": "node scripts/release.mjs --target=server --variant=full",
    "release:mac:lite": "node scripts/release.mjs --target=darwin-arm64 --variant=lite",
    "release:mac:full": "node scripts/release.mjs --target=darwin-arm64 --variant=full",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r --if-present test",
    "check:dependencies": "node scripts/check-dependency-versions.mjs"
  },
  "devDependencies": {
    "@dsh-station/dsh-plugin-agents-md": "workspace:*",
    "@dsh-station/dsh-plugin-browser-compat": "workspace:*",
    "@dsh-station/dsh-plugin-chat-scroll": "workspace:*",
    "@dsh-station/dsh-plugin-concise-mode": "workspace:*",
    "@dsh-station/dsh-plugin-conversation-enhancements": "workspace:0.0.2-20260927",
    "@dsh-station/dsh-plugin-copilot-auth": "workspace:*",
    "@dsh-station/dsh-plugin-development-tools": "workspace:0.0.2-20260927",
    "@dsh-station/dsh-plugin-directory-picker-browse": "workspace:*",
    "@dsh-station/dsh-plugin-favorite-models": "workspace:*",
    "@dsh-station/dsh-plugin-files": "workspace:*",
    "@dsh-station/dsh-plugin-model-capabilities": "workspace:*",
    "@dsh-station/dsh-plugin-model-enhancements": "workspace:0.0.2-20260927",
    "@dsh-station/dsh-plugin-models-catalog": "workspace:*",
    "@dsh-station/dsh-plugin-notify": "workspace:*",
    "@dsh-station/dsh-plugin-proxy": "workspace:*",
    "@dsh-station/dsh-plugin-remote-experience": "workspace:0.0.2-20260927",
    "@dsh-station/dsh-plugin-remote-privileged": "workspace:*",
    "@dsh-station/dsh-plugin-remote-settings": "workspace:*",
    "@dsh-station/dsh-plugin-services": "workspace:*",
    "@dsh-station/dsh-plugin-skills-inspector": "workspace:*",
    "@dsh-station/dsh-plugin-terminal": "workspace:*",
    "@dsh-station/dsh-plugin-tools-inspector": "workspace:*",
    "@dsh-station/dsh-plugin-turn-retry": "workspace:*",
    "@dsh-station/dsh-plugin-user-message-fork": "workspace:*",
    "@dsh-station/dsh-plugin-yolo-mode": "workspace:*",
    "@types/node": "22.20.4",
    "archiver": "8.0.0",
    "husky": "9.1.7",
    "oxlint": "1.85.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "4.0.4",
      "@deepseek-ai/dsh-anonymous-user-id": "0.1.7-rc.2",
      "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
      "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
      "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
      "@deepseek-ai/dsh-authorization": "0.1.7-rc.2",
      "@deepseek-ai/dsh-bash-local": "0.1.7-rc.2",
      "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
      "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
      "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
      "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.2",
